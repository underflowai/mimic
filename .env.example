# OpenAI — used for director LLM, background tasks, and web search
OPENAI_API_KEY=

# Anthropic — only needed if using Anthropic as the director provider
# ANTHROPIC_API_KEY=

# Deepgram — speech-to-text (Flux v2)
DEEPGRAM_API_KEY=

# Cartesia — text-to-speech (Sonic)
CARTESIA_API_KEY=

# Director provider: openai (default) or anthropic
# MIMIC_DIRECTOR_PROVIDER=openai

# Engine tuning (optional — defaults shown). Validated at read time.
# MIMIC_FLUX_MODEL=flux-general-en          # Deepgram Flux model (e.g. flux-general-multi for multilingual)
# MIMIC_FLUX_EOT_THRESHOLD=0.7              # final EOT confidence (0.5–0.9); higher waits for stronger evidence
# MIMIC_FLUX_EAGER_EOT_THRESHOLD=0.3        # eager speculation confidence (0.3–0.9; must be <= final EOT)
# MIMIC_FLUX_EOT_TIMEOUT_MS=3000            # silence that forces end-of-turn (500–60000)
# MIMIC_FLUX_CAREFUL_EOT_THRESHOLD=0.85     # stricter EOT for one turn after the agent asks for an email/phone/spelling
# MIMIC_FLUX_CAREFUL_EOT_TIMEOUT_MS=5000    # silence timeout while careful endpointing is active
# MIMIC_LOW_CONFIDENCE_EOT=0.35             # below this: no eager draft, and a timeout-forced final is treated as trailing off
# MIMIC_SUBSTANTIVE_SPEECH_MS=350           # soft pause waits this long for the transcriber before deciding
# MIMIC_VAD_ONLY_GRACE_MS=500               # extra wait when VAD fired but no words arrived; still nothing = noise, resume
# MIMIC_YIELD_WINDOW_MS=80                  # VAD onset to soft pause
# MIMIC_LATENCY_FILLER_MS=1000              # say "Hmm." / "Let me see." if the model's first token is later than this (0 = off)
# MIMIC_HOLD_IDLE_MS=45000                  # silence allowed after the caller asks us to hold (vs 6s normally)

# Logging: LOG_LEVEL (pino level, default info), LOG_PRETTY=1|0 (default: pretty outside production)
# LOG_LEVEL=info

# LiveKit — real-time audio transport
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

# Redis — job queue for call processing (worker process)
REDIS_URL=redis://localhost:6379
# Set to 1 only when running a dedicated worker process.
# MIMIC_DISABLE_IN_PROCESS_WORKER=1

# Postgres — API keys, agents, calls, transcripts, and results
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mimic

# Call recording (optional) — S3-compatible storage for OGG recordings
# RECORDING_S3_BUCKET=
# RECORDING_S3_ACCESS_KEY=
# RECORDING_S3_SECRET=
# RECORDING_S3_REGION=us-east-1
# RECORDING_S3_ENDPOINT=
