# OpenAI — used for director LLM, background tasks, and web search
OPENAI_API_KEY=

# Anthropic — only needed if using Anthropic as the director provider
# ANTHROPIC_API_KEY=

# Deepgram — speech-to-text (Flux v2)
DEEPGRAM_API_KEY=

# Cartesia — text-to-speech (Sonic)
CARTESIA_API_KEY=

# Director provider: openai (default) or anthropic
# MIMIC_DIRECTOR_PROVIDER=openai

# Engine tuning (optional — defaults shown). Validated at read time.
# MIMIC_FLUX_MODEL=flux-general-en          # Deepgram Flux model (e.g. flux-general-multi for multilingual)
# MIMIC_FLUX_EOT_THRESHOLD=0.5              # end-of-turn confidence that commits a turn (0–1)
# MIMIC_FLUX_EAGER_EOT_THRESHOLD=0.3        # confidence that triggers eager speculation (0–1)
# MIMIC_FLUX_EOT_TIMEOUT_MS=2000            # silence that forces end-of-turn (500–10000)
# MIMIC_SUBSTANTIVE_SPEECH_MS=350           # caller speech shorter than this during agent speech = backchannel
# MIMIC_YIELD_WINDOW_MS=80                  # grace window after a soft pause before the agent resumes

# Logging: LOG_LEVEL (pino level, default info), LOG_PRETTY=1|0 (default: pretty outside production)
# LOG_LEVEL=info

# LiveKit — real-time audio transport
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

# Redis — job queue for call processing (worker process)
REDIS_URL=redis://localhost:6379
# Set to 1 only when running a dedicated worker process.
# MIMIC_DISABLE_IN_PROCESS_WORKER=1

# Postgres — API keys, agents, calls, transcripts, and results
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mimic

# Call recording (optional) — S3-compatible storage for OGG recordings
# RECORDING_S3_BUCKET=
# RECORDING_S3_ACCESS_KEY=
# RECORDING_S3_SECRET=
# RECORDING_S3_REGION=us-east-1
# RECORDING_S3_ENDPOINT=
